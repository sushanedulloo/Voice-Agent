# Copy to .env and fill in. Nothing here has a safe default - the service tells you at startup
# if OUTBOUND_API_TOKEN is unset rather than quietly running open.

# Bearer token for the API. Production terminates auth at the partner's gateway with mTLS;
# this is the belt to that gateway's braces.
OUTBOUND_API_TOKEN=

# Content pack directory. Omit for the bundled synthetic placeholder.
# Set to the BLC-approved pack before any live call:
#   OUTBOUND_CONTENT_PACK=packs/sbic-blc-2026-10
OUTBOUND_CONTENT_PACK=

OUTBOUND_API_PORT=8078
